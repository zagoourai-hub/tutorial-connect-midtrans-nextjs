{
  "name": "midtrans-tutorial",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter next-app dev",
    "dev:example": "pnpm --filter payment-example dev",
    "build": "pnpm --filter next-app build",
    "start": "node scripts/serve-docs.ts",
    "lint": "pnpm --filter next-app lint",
    "typecheck": "pnpm --filter next-app typecheck && tsc --noEmit -p tsconfig.tools.json",
    "format": "pnpm --filter next-app format",
    "snippets": "node scripts/validate-snippets.ts",
    "links": "node scripts/validate-links.ts",
    "prisma:validate": "pnpm --filter payment-example exec prisma validate",
    "prisma:generate": "pnpm --filter payment-example exec prisma generate"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
