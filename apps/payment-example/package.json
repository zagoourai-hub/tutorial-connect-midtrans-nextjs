{
  "name": "payment-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "reconcile": "tsx --env-file-if-exists=.env scripts/reconcile.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "midtrans-client": "1.4.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "typescript": "6.0.3"
  }
}
